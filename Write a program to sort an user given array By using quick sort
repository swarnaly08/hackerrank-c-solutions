#include <stdio.h>
void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}
int part(int *arr, int beg, int end) {
    int l = beg, r = end, loc = beg, f = 0;
    while (l < r) {
        while(arr[loc] <= arr[r] && loc != r) {
            r--;
        }
        if(arr[loc] > arr[r]) {
            swap(arr+loc, arr+r);
            loc = r;
        }
        while(arr[loc] >= arr[l] && loc != l) {
            l++;
        }
        if(arr[loc] < arr[l]) {
            swap(arr+loc, arr+l);
            loc = l;
        }
        if(l == r) {
            f = 1;
        } 
    }
    return loc;
}
void qksort(int *arr, int beg, int end) {
    if(beg < end) {
        int loc = part(arr, beg, end);
        qksort(arr, beg, loc-1);
        qksort(arr, loc+1, end);
    }
}
int main() {
    int n;
    scanf("%d", &n);
    int a[n];
    for(int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    qksort(a, 0, n-1);
    for(int i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }
    return 0;
}
