#include <stdio.h>
void merge(int *a, int b, int m, int e){
    int i = b,j = m+1,k = 0;
    int t[e-b+1];
    while(i <= m && j <= e){
        if(a[i] < a[j]){
            t[k++] = a[i++];
        } else {
            t[k++] = a[j++];
        }
    }
    while(i <= m){
        t[k++] = a[i++];
    }
    while(j <= e){
        t[k++] = a[j++];
    }
    for(i = b, k = 0; i <= e; i++, k++){
        a[i] = t[k];
    }
}
void msort(int *a, int b, int e){
    if(b < e){
        int m = (b+e)/2;
        msort(a,b,m);
        msort(a, m+1, e);
        merge(a, b, m, e);
    }
}
int main() {
    int n;
    scanf("%d", &n);
    int a[n];
    for(int i = 0; i < n; i++){
        scanf("%d", &a[i]);
    }
    msort(a, 0, n - 1);
    for(int i = 0; i < n; i++){
        printf("%d ", a[i]);
    }   
    return 0;
}
